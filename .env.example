# ============================================================
# 衡练 AI 助手 环境变量模板
# 使用方法：复制本文件为 .env 并填入真实值。.env 已被 .gitignore 排除，
# 严禁把真实密钥提交到 Git 仓库！
# ============================================================

# 阿里百炼 DashScope API Key（https://bailian.console.aliyun.com/ 控制台获取）
DASHSCOPE_API_KEY=sk-你的密钥

# OpenAI 兼容端点（默认阿里百炼；可换 Ollama: http://localhost:11434/v1 等）
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 模型名（默认通义千问 qwen-plus；可换 qwen-turbo / qwen-max 等）
MODEL_NAME=qwen-plus

# Agent 后端：langgraph（默认，LangGraph StateGraph 框架）/ custom（自研 Tool Calling 循环）
AGENT_BACKEND=langgraph
