    <Box style={{ background: '#101C2B', border: '1px solid #27405C', borderRadius: 14, paddingLeft: 22, paddingRight: 22, paddingTop: 16, paddingBottom: 16, flexDirection: 'row', gap: 14, alignItems: 'center' }}>
