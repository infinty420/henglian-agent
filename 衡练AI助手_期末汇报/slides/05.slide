            <Text style={{ fontSize: 22, fontWeight: 'bold', color: '#38BDF8' }}>03</Text>
            <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#F1F5F9' }}>recovery_meal_plan</Text>
            <Text style={{ fontSize: 17, color: '#94A3B8', lineHeight: 1.55 }}>蛋白 38g / 碳水 63g<br />脂肪 11g 的恢复餐</Text>
