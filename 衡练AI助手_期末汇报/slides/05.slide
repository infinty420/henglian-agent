            <Text style={{ fontSize: 22, fontWeight: 'bold', color: '#38BDF8' }}>01</Text>
            <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#F1F5F9' }}>evaluate_training</Text>
            <Text style={{ fontSize: 17, color: '#94A3B8', lineHeight: 1.55 }}>负荷 47 → 判定偏低<br />建议恢复 8 小时</Text>
        </Box>
        <Box style={{ width: 42, alignItems: 'center', justifyContent: 'center' }}><Text style={{ fontSize: 22, color: '#38BDF8' }}>→</Text></Box>
        <Box style={{ width: 358, background: '#0F1A28', border: '1px solid #27405C', borderRadius: 12, padding: 18, gap: 10 }}>
            <Text style={{ fontSize: 22, fontWeight: 'bold', color: '#38BDF8' }}>02</Text>
            <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#F1F5F9' }}>plan_next_workout</Text>
            <Text style={{ fontSize: 17, color: '#94A3B8', lineHeight: 1.55 }}>力量 → 有氧慢跑<br />加全身拉伸 25 分钟</Text>
        </Box>
        <Box style={{ width: 42, alignItems: 'center', justifyContent: 'center' }}><Text style={{ fontSize: 22, color: '#38BDF8' }}>→</Text></Box>
